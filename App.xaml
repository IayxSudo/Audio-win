<Application x:Class="AudioWin.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:AudioWin"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Controls.xaml pulls in Theme.xaml itself, so StaticResource
                     lookups inside the templates resolve against one dictionary. -->
                <ResourceDictionary Source="Themes/Controls.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <local:BoolToVisibilityConverter x:Key="BoolToVis"/>
            <local:HasValueToVisibilityConverter x:Key="HasValueToVis"/>
            <local:SourceToBrushConverter x:Key="SourceToBrush"/>
            <local:SubtractConverter x:Key="Subtract"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
