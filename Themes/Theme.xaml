<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ===================================================================
         PALETTE
         These Color resources are the single source of truth for theming.
         ThemeManager.Apply() overwrites every one of them at runtime, and
         because every brush below binds its Color with DynamicResource the
         whole UI re-colours itself instantly with no restart.
         The values here are the Dark defaults.
         =================================================================== -->

    <Color x:Key="C.Base">#FF000000</Color>
    <Color x:Key="C.Surface">#FF000000</Color>
    <Color x:Key="C.SurfaceAlt">#FF050505</Color>
    <Color x:Key="C.Elevated">#FF0A0A0A</Color>
    <Color x:Key="C.Overlay">#FF121212</Color>
    <Color x:Key="C.Stroke">#FF1E1E1E</Color>
    <Color x:Key="C.StrokeSoft">#FF121212</Color>

    <Color x:Key="C.Text">#FFFFFFFF</Color>
    <Color x:Key="C.TextMuted">#FFA0A0A0</Color>
    <Color x:Key="C.TextDim">#FF606060</Color>

    <Color x:Key="C.Accent">#FFFFFFFF</Color>
    <Color x:Key="C.AccentAlt">#FFFFFFFF</Color>
    <Color x:Key="C.AccentSoft">#25FFFFFF</Color>
    <Color x:Key="C.OnAccent">#FF000000</Color>

    <Color x:Key="C.Danger">#FFF04A5C</Color>
    <Color x:Key="C.Success">#FF3DD68C</Color>
    <Color x:Key="C.Warning">#FFF5A524</Color>

    <Color x:Key="C.Hover">#1AFFFFFF</Color>
    <Color x:Key="C.Pressed">#33FFFFFF</Color>
    <Color x:Key="C.Selected">#2AFFFFFF</Color>
    <Color x:Key="C.Scrim">#D9000000</Color>
    <Color x:Key="C.Shadow">#FF000000</Color>

    <!-- ===================================================================
         BRUSHES
         =================================================================== -->

    <SolidColorBrush x:Key="B.Base"        Color="{DynamicResource C.Base}"/>
    <SolidColorBrush x:Key="B.Surface"     Color="{DynamicResource C.Surface}"/>
    <SolidColorBrush x:Key="B.SurfaceAlt"  Color="{DynamicResource C.SurfaceAlt}"/>
    <SolidColorBrush x:Key="B.Elevated"    Color="{DynamicResource C.Elevated}"/>
    <SolidColorBrush x:Key="B.Overlay"     Color="{DynamicResource C.Overlay}"/>
    <SolidColorBrush x:Key="B.Stroke"      Color="{DynamicResource C.Stroke}"/>
    <SolidColorBrush x:Key="B.StrokeSoft"  Color="{DynamicResource C.StrokeSoft}"/>

    <SolidColorBrush x:Key="B.Text"        Color="{DynamicResource C.Text}"/>
    <SolidColorBrush x:Key="B.TextMuted"   Color="{DynamicResource C.TextMuted}"/>
    <SolidColorBrush x:Key="B.TextDim"     Color="{DynamicResource C.TextDim}"/>

    <SolidColorBrush x:Key="B.Accent"      Color="{DynamicResource C.Accent}"/>
    <SolidColorBrush x:Key="B.AccentAlt"   Color="{DynamicResource C.AccentAlt}"/>
    <SolidColorBrush x:Key="B.AccentSoft"  Color="{DynamicResource C.AccentSoft}"/>
    <SolidColorBrush x:Key="B.OnAccent"    Color="{DynamicResource C.OnAccent}"/>

    <SolidColorBrush x:Key="B.Danger"      Color="{DynamicResource C.Danger}"/>
    <SolidColorBrush x:Key="B.Success"     Color="{DynamicResource C.Success}"/>
    <SolidColorBrush x:Key="B.Warning"     Color="{DynamicResource C.Warning}"/>

    <SolidColorBrush x:Key="B.Hover"       Color="{DynamicResource C.Hover}"/>
    <SolidColorBrush x:Key="B.Pressed"     Color="{DynamicResource C.Pressed}"/>
    <SolidColorBrush x:Key="B.Selected"    Color="{DynamicResource C.Selected}"/>
    <SolidColorBrush x:Key="B.Scrim"       Color="{DynamicResource C.Scrim}"/>
    <SolidColorBrush x:Key="B.Transparent" Color="#00000000"/>

    <!-- Accent solid / neutral white brushes -->
    <SolidColorBrush x:Key="B.AccentGradient" Color="{DynamicResource C.Accent}"/>
    <SolidColorBrush x:Key="B.AccentGradientH" Color="{DynamicResource C.Accent}"/>

    <SolidColorBrush x:Key="B.ContentWash" Color="{DynamicResource C.Base}"/>

    <SolidColorBrush x:Key="B.ArtPlaceholder" Color="{DynamicResource C.Elevated}"/>

    <!-- ===================================================================
         TYPOGRAPHY
         =================================================================== -->

    <FontFamily x:Key="F.Sans">Segoe UI Variable Display, Segoe UI Variable Text, Segoe UI, Inter, Roboto, Arial</FontFamily>
    <FontFamily x:Key="F.Numeric">Segoe UI Variable Text, Segoe UI, Consolas, Arial</FontFamily>

    <sys:Double x:Key="S.Display">40</sys:Double>
    <sys:Double x:Key="S.Title">26</sys:Double>
    <sys:Double x:Key="S.Heading">17</sys:Double>
    <sys:Double x:Key="S.Body">13.5</sys:Double>
    <sys:Double x:Key="S.Small">12</sys:Double>
    <sys:Double x:Key="S.Micro">10.5</sys:Double>

    <!-- ===================================================================
         MOTION
         =================================================================== -->

    <CubicEase x:Key="E.Out" EasingMode="EaseOut"/>
    <CubicEase x:Key="E.InOut" EasingMode="EaseInOut"/>
    <QuinticEase x:Key="E.OutStrong" EasingMode="EaseOut"/>
    <BackEase x:Key="E.OutBack" EasingMode="EaseOut" Amplitude="0.35"/>
    <ExponentialEase x:Key="E.OutExpo" EasingMode="EaseOut" Exponent="5"/>

    <!-- ===================================================================
         ELEVATION (No glow, flat clean dark design)
         =================================================================== -->

    <DropShadowEffect x:Key="FX.CardShadow" BlurRadius="0" ShadowDepth="0" Direction="0" Opacity="0" Color="#000000"/>
    <DropShadowEffect x:Key="FX.PopupShadow" BlurRadius="0" ShadowDepth="0" Direction="0" Opacity="0" Color="#000000"/>
    <DropShadowEffect x:Key="FX.AccentGlow" BlurRadius="0" ShadowDepth="0" Direction="0" Opacity="0" Color="#000000"/>

