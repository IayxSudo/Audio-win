<Window x:Class="AudioWin.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AudioWin"
        mc:Ignorable="d"
        Title="AudioWin" Height="900" Width="1400" Icon="pack://application:,,,/app.png"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource ForegroundBrush}"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        WindowStyle="None">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32" 
                      ResizeBorderThickness="5" 
                      GlassFrameThickness="0" 
                      CornerRadius="0"/>
    </WindowChrome.WindowChrome>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="110"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Entire Top Bar Area -->
        <Grid Grid.Row="0" Grid.ColumnSpan="2" Background="Transparent">
            <!-- Visual Background (Non-interactive for the system drag to pass through) -->
            <Border Background="{StaticResource BackgroundBrush}" BorderBrush="{StaticResource SecondaryBrush}" BorderThickness="0,0,0,1" IsHitTestVisible="False"/>

            <!-- Branding / Logo -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0" IsHitTestVisible="False">
                <TextBlock Text="AUDIOWIN" FontSize="11" FontWeight="Bold" Foreground="{StaticResource GrayBrush}" Opacity="0.8"/>
            </StackPanel>

            <!-- Window Controls (Explicitly hit-testable in chrome) -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Content="—" Style="{StaticResource WindowControlButton}" Click="BtnMinimize_Click"/>
                <Button x:Name="BtnMaximize" Content="☐" Style="{StaticResource WindowControlButton}" Click="BtnMaximize_Click"/>
                <Button Content="✕" Style="{StaticResource CloseButton}" Click="BtnClose_Click"/>
            </StackPanel>
        </Grid>

        <!-- Sidebar -->
        <Border Grid.Row="1" Grid.Column="0" Background="{StaticResource SecondaryBrush}" BorderBrush="{StaticResource SecondaryBrush}" BorderThickness="0,0,1,0">
            <StackPanel Margin="10,25,10,0">
                <Button x:Name="BtnSidebarHome" Style="{StaticResource SidebarButtonActive}" Click="BtnHome_Click" Margin="0,0,0,6">
                    <TextBlock Text="Home" VerticalAlignment="Center" Margin="10,0,0,0"/>
                </Button>
                <Button x:Name="BtnSidebarStats" Style="{StaticResource SidebarButton}" Click="BtnStats_Click" Margin="0,0,0,6">
                    <TextBlock Text="Statistics" VerticalAlignment="Center" Margin="10,0,0,0"/>
                </Button>
                <Button x:Name="BtnSidebarLiked" Style="{StaticResource SidebarButton}" Click="BtnLikedSongs_Click" Margin="0,0,0,6">
                    <TextBlock Text="Liked Songs" VerticalAlignment="Center" Margin="10,0,0,0"/>
                </Button>

                <Border Background="{StaticResource HoverBrush}" CornerRadius="6" Margin="6,5,6,20" Height="38" Padding="15,0">
                    <TextBox x:Name="TxtSearch" Background="Transparent" BorderThickness="0" Foreground="White" 
                             local:PlaceholderBehavior.Placeholder="Search Playlists..." TextChanged="TxtSearch_TextChanged" FontSize="13" VerticalAlignment="Center"/>
                </Border>

                <Button Style="{StaticResource SidebarButton}" x:Name="BtnCreatePlaylist" Click="BtnCreatePlaylist_Click" Margin="0,0,0,20">
                    <TextBlock Text="New Playlist" VerticalAlignment="Center" Margin="10,0,0,0"/>
                </Button>
                
                <TextBlock Text="PLAYLISTS" FontSize="10" Foreground="{StaticResource GrayBrush}" FontWeight="Bold" Margin="16,0,0,12" Opacity="0.5"/>
                
                <ListBox x:Name="PlaylistsList" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Delete Playlist" Click="DeletePlaylist_Click"/>
                        </ContextMenu>
                    </ListBox.ContextMenu>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd" Padding="16,8" Background="Transparent" CornerRadius="6" Margin="0,1" Cursor="Hand" MouseLeftButtonDown="SidebarPlaylistItem_Click">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SelectionBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" FontSize="13" Foreground="{StaticResource GrayBrush}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1" Grid.Column="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Grid>
                    <!-- Home View -->
                    <StackPanel x:Name="PlaylistsGrid" Margin="50,40">
                        <TextBlock Text="Your Playlists" FontSize="48" FontWeight="Bold" Margin="0,0,0,50"/>
                        <ItemsControl ItemsSource="{Binding ElementName=PlaylistsList, Path=ItemsSource}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="220" Margin="0,0,40,50" Cursor="Hand" MouseLeftButtonDown="PlaylistCard_Click" Background="Transparent">
                                        <Border.RenderTransform>
                                            <ScaleTransform CenterX="110" CenterY="110"/>
                                        </Border.RenderTransform>
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <EventTrigger RoutedEvent="MouseEnter">
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetProperty="(RenderTransform).ScaleX" To="1.05" Duration="0:0:0.2"/>
                                                                <DoubleAnimation Storyboard.TargetProperty="(RenderTransform).ScaleY" To="1.05" Duration="0:0:0.2"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </EventTrigger>
                                                    <EventTrigger RoutedEvent="MouseLeave">
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetProperty="(RenderTransform).ScaleX" To="1.0" Duration="0:0:0.2"/>
                                                                <DoubleAnimation Storyboard.TargetProperty="(RenderTransform).ScaleY" To="1.0" Duration="0:0:0.2"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </EventTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel>
                                            <Border Width="220" Height="220" Background="#0D0D0D" Margin="0,0,0,15" CornerRadius="8" ClipToBounds="True">
                                                <Grid>
                                                    <Image Source="{Binding ImagePath}" Stretch="UniformToFill"/>
                                                    <TextBlock x:Name="DefaultText" Text="{Binding Icon}" FontSize="72" FontWeight="Black" Foreground="{StaticResource GrayBrush}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding ImagePath}" Value="{x:Null}">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Grid>
                                            </Border>
                                            <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="Bold" Margin="0,0,0,5"/>
                                            <TextBlock Text="Playlist" FontSize="12" Foreground="{StaticResource GrayBrush}"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- Stats View -->
                    <StackPanel x:Name="StatsGrid" Margin="50,40" Visibility="Collapsed">
                        <TextBlock Text="Your Statistics" FontSize="48" FontWeight="Bold" Margin="0,0,0,50"/>
                        <UniformGrid Columns="2" Margin="0,0,0,40">
                            <Border Background="#0D0D0D" Margin="0,0,20,20" Padding="30" CornerRadius="12">
                                <StackPanel>
                                    <TextBlock Text="Total Listened Time" FontSize="14" Foreground="{StaticResource GrayBrush}" Margin="0,0,0,10"/>
                                    <TextBlock x:Name="StatTotalTime" Text="0 hours" FontSize="32" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#0D0D0D" Margin="20,0,0,20" Padding="30" CornerRadius="12">
                                <StackPanel>
                                    <TextBlock Text="Songs Played" FontSize="14" Foreground="{StaticResource GrayBrush}" Margin="0,0,0,10"/>
                                    <TextBlock x:Name="StatTotalPlayed" Text="0" FontSize="32" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#0D0D0D" Margin="0,20,20,0" Padding="30" CornerRadius="12">
                                <StackPanel>
                                    <TextBlock Text="Most Played Playlist" FontSize="14" Foreground="{StaticResource GrayBrush}" Margin="0,0,0,10"/>
                                    <TextBlock x:Name="StatMostPlayedPlaylist" Text="None yet" FontSize="32" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#0D0D0D" Margin="20,20,0,0" Padding="30" CornerRadius="12">
                                <StackPanel>
                                    <TextBlock Text="First Listened Song" FontSize="14" Foreground="{StaticResource GrayBrush}" Margin="0,0,0,10"/>
                                    <TextBlock x:Name="StatFirstSong" Text="None yet" FontSize="24" FontWeight="Bold" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                    </StackPanel>

                    <!-- Playlist Detail View -->
                    <StackPanel x:Name="SongsView" Visibility="Collapsed">
                        <Grid Margin="50,60,50,40">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="232"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <Border Width="232" Height="232" Background="#0D0D0D" CornerRadius="12" BorderBrush="{StaticResource HoverBrush}" BorderThickness="1" ClipToBounds="True" Cursor="Hand" MouseLeftButtonUp="BtnChangeCover_Click">
                                <Grid>
                                    <Image x:Name="DetailCoverImage" Stretch="UniformToFill"/>
                                    <TextBlock x:Name="DetailDefaultText" Text="" FontSize="72" FontWeight="Black" Foreground="{StaticResource GrayBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Margin="35,0,0,0">
                                <TextBlock Text="PLAYLIST" FontSize="12" FontWeight="Bold" Margin="0,0,0,10" Opacity="0.7"/>
                                <TextBlock x:Name="DetailTitle" Text="Playlist Name" FontSize="86" FontWeight="Black" Margin="0,-15,0,10"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="DetailStats" Text="0 songs, about 0 min" Foreground="{StaticResource GrayBrush}"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="50,0,50,20">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="BtnDetailPlay" Width="56" Height="56" Background="White" Foreground="Black" Click="BtnPlayPause_Click" Margin="0,0,25,0">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="28">
                                                <Path Data="M 0,0 L 16,10 L 0,20 Z" Fill="Black" Stretch="Uniform" Width="20" Height="20" Margin="4,0,0,0"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <Button x:Name="BtnShuffleDetail" Width="40" Height="40" Background="Transparent" Margin="0,0,25,0" Click="BtnShuffle_Click">
                                    <Path Data="M 10.59,9.17 L 5.41,4 L 4,5.41 L 9.17,10.58 L 10.59,9.17 Z M 14.5,4 L 16.29,5.71 L 4,18 L 5.41,19.41 L 17.7,7.12 L 19.41,8.83 L 19.41,4 L 14.5,4 Z M 14.5,14.83 L 13.08,16.25 L 16.29,19.46 L 17.7,18.05 L 14.5,14.83 Z" Fill="{StaticResource GrayBrush}" Stretch="Uniform" Width="24" Height="24"/>
                                </Button>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Border Background="{StaticResource HoverBrush}" CornerRadius="6" Padding="10,6" Margin="0,0,20,0">
                                    <Grid Width="180">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Path Data="M 15.5,14 H 14.7 L 14.4,13.7 C 15.4,12.6 16,11.1 16,9.5 C 16,5.9 13.1,3 9.5,3 C 5.9,3 3,5.9 3,9.5 C 3,13.1 5.9,16 9.5,16 C 11.1,16 12.6,15.4 13.7,14.4 L 14,14.7 V 15.5 L 19,20.5 L 20.5,19 L 15.5,14 Z M 9.5,14 C 7,14 5,12 5,9.5 C 5,7 7,5 9.5,5 C 12,5 14,7 14,9.5 C 14,12 12,14 9.5,14 Z" Fill="{StaticResource GrayBrush}" Stretch="Uniform" Width="16" Height="16" Margin="0,0,10,0"/>
                                        <TextBox x:Name="TxtSongSearch" Grid.Column="1" Background="Transparent" BorderThickness="0" Foreground="White" local:PlaceholderBehavior.Placeholder="Search in playlist" TextChanged="TxtSongSearch_TextChanged"/>
                                    </Grid>
                                </Border>
                                <TextBlock Text="Sort by:" Foreground="{StaticResource GrayBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <ComboBox x:Name="ComboSort" Width="150" VerticalAlignment="Center" SelectionChanged="ComboSort_SelectionChanged">
                                    <ComboBoxItem Content="Custom order" IsSelected="True"/>
                                    <ComboBoxItem Content="Title"/>
                                    <ComboBoxItem Content="Artist"/>
                                    <ComboBoxItem Content="Duration"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <!-- Header Labels -->
                        <Grid Margin="50,10,50,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="120"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="#" Foreground="{StaticResource GrayBrush}" FontSize="11" FontWeight="Bold" Margin="20,0,0,0"/>
                            <TextBlock Grid.Column="1" Text="TITLE" Foreground="{StaticResource GrayBrush}" FontSize="11" FontWeight="Bold"/>
                            <TextBlock Grid.Column="2" Text="ARTIST" Foreground="{StaticResource GrayBrush}" FontSize="11" FontWeight="Bold"/>
                            <Path Grid.Column="3" Data="M 12,2 C 6.48,2 2,6.48 2,12 C 2,17.52 6.48,22 12,22 C 17.52,22 22,17.52 22,12 C 22,6.48 17.52,2 12,2 Z M 16.2,16.2 L 11,13 V 7 H 12.5 V 12.2 L 17,14.9 L 16.2,16.2 Z" Fill="{StaticResource GrayBrush}" Stretch="Uniform" Width="14" Height="14" HorizontalAlignment="Left" Margin="0,0,0,0"/>
                        </Grid>
                        <Separator Margin="50,10" Background="{StaticResource HoverBrush}" Height="1"/>

                        <!-- Empty State -->
                        <Border x:Name="EmptyPlaylistState" Height="300" Margin="50,0" Background="{StaticResource SecondaryBrush}" BorderBrush="{StaticResource HoverBrush}" BorderThickness="1" CornerRadius="12" Cursor="Hand" MouseLeftButtonUp="EmptyStateAdd_Click" Visibility="Collapsed">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Path Data="M12,2 C6.48,2 2,6.48 2,12 C2,17.52 6.48,22 12,22 C17.52,22 22,17.52 22,12 C22,6.48 17.52,2 12,2 Z M12,7 V17 M7,12 H17" 
                                      Stroke="{StaticResource GrayBrush}" StrokeThickness="1.5" Fill="Transparent" Stretch="Uniform" Width="48" Height="48" Margin="0,0,0,20"/>
                                <TextBlock Text="Add Audio Files" FontSize="20" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                                <TextBlock Text="Click to browse your music library" FontSize="13" Foreground="{StaticResource GrayBrush}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Song List -->
                        <ListBox x:Name="SongsGrid" Margin="50,0" Background="Transparent" BorderThickness="0" 
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch"
                                 MouseDoubleClick="SongsGrid_MouseDoubleClick">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="Bd" Padding="10,0" CornerRadius="6" Background="Transparent" Margin="0,2">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBrush}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="{StaticResource SelectionBrush}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Height="56">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="50"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="120"/>
                                        </Grid.ColumnDefinitions>

                                        <Grid Margin="10,0,0,0">
                                            <TextBlock x:Name="IndexText" Text="{Binding Index}" VerticalAlignment="Center" Foreground="{StaticResource GrayBrush}" FontSize="14"/>
                                            <Path x:Name="PlayIcon" Data="M 0,0 L 12,8 L 0,16 Z" Fill="White" Stretch="Uniform" Width="12" Height="12" Visibility="Collapsed" VerticalAlignment="Center" Margin="-2,0,0,0"/>
                                        </Grid>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" Foreground="White"/>
                                        </StackPanel>

                                        <TextBlock Grid.Column="2" Text="{Binding Artist}" VerticalAlignment="Center" Foreground="{StaticResource GrayBrush}" FontSize="14"/>

                                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding Duration}" Foreground="{StaticResource GrayBrush}" FontSize="14" Width="50"/>
                                            <ToggleButton IsChecked="{Binding IsLiked, Mode=TwoWay}" Click="BtnTrackLike_Click" Background="Transparent" BorderThickness="0" Width="20" Height="20" Margin="15,0,0,0">
                                                <ToggleButton.Template>
                                                    <ControlTemplate TargetType="ToggleButton">
                                                        <Path x:Name="Icon" Data="M 12,21.35 L 10.55,20.03 C 5.4,15.36 2,12.27 2,8.5 C 2,5.41 4.41,3 7.5,3 C 9.24,3 10.91,3.81 12,5.08 C 13.09,3.81 14.76,3 16.5,3 C 19.59,3 22,5.41 22,8.5 C 22,12.27 18.6,15.36 13.45,20.03 L 12,21.35 Z" 
                                                              Fill="{StaticResource GrayBrush}" Stretch="Uniform" Opacity="0.5"/>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsChecked" Value="True">
                                                                <Setter TargetName="Icon" Property="Fill" Value="White"/>
                                                                <Setter TargetName="Icon" Property="Opacity" Value="1"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </ToggleButton.Template>
                                            </ToggleButton>
                                        </StackPanel>
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                            <Setter TargetName="IndexText" Property="Visibility" Value="Collapsed"/>
                                            <Setter TargetName="PlayIcon" Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <Button x:Name="BtnAddAudio" Content="+ Add more tracks" Style="{StaticResource SidebarButton}" Margin="50,30,0,100" Click="BtnAddAudio_Click"/>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>

        <!-- Player Bar -->
        <Border Grid.Row="2" Grid.ColumnSpan="2" Background="{StaticResource BackgroundBrush}" BorderBrush="{StaticResource SecondaryBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="35,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="380"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="380"/>
                </Grid.ColumnDefinitions>

                <!-- Now Playing -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="72" Height="72" Background="#0D0D0D" CornerRadius="8" Margin="0,0,20,0" ClipToBounds="True">
                        <Grid>
                            <Image x:Name="PlayerCoverImage" Stretch="UniformToFill"/>
                            <Path x:Name="PlayerDefaultIcon" Data="M9,17 C9,15.3 7.7,14 6,14 C4.3,14 3,15.3 3,17 C3,18.7 4.3,20 6,20 C7.7,20 9,18.7 9,17 Z M9,17 V3 H17 V7" 
                                  Stroke="{StaticResource GrayBrush}" StrokeThickness="1.8" Fill="Transparent" Stretch="Uniform" Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="TxtNowPlayingTitle" Text="Not Playing" FontSize="16" FontWeight="Bold" Margin="0,0,0,5"/>
                        <TextBlock x:Name="TxtNowPlayingArtist" Text="Select a track" FontSize="13" Foreground="{StaticResource GrayBrush}"/>
                    </StackPanel>
                    <ToggleButton x:Name="BtnLikeCurrent" Click="BtnLikeCurrent_Click" Background="Transparent" Margin="20,0,0,0" BorderThickness="0" Width="20" Height="20">
                        <ToggleButton.Template>
                            <ControlTemplate TargetType="ToggleButton">
                                <Path x:Name="Icon" Data="M 12,21.35 L 10.55,20.03 C 5.4,15.36 2,12.27 2,8.5 C 2,5.41 4.41,3 7.5,3 C 9.24,3 10.91,3.81 12,5.08 C 13.09,3.81 14.76,3 16.5,3 C 19.59,3 22,5.41 22,8.5 C 22,12.27 18.6,15.36 13.45,20.03 L 12,21.35 Z" 
                                      Fill="{StaticResource GrayBrush}" Stretch="Uniform" Opacity="0.5"/>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="Icon" Property="Fill" Value="White"/>
                                        <Setter TargetName="Icon" Property="Opacity" Value="1"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </ToggleButton.Template>
                    </ToggleButton>
                </StackPanel>

                <!-- Controls -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,15">
                        <Button x:Name="BtnShufflePlayer" Width="40" Height="40" Background="Transparent" Margin="0,0,30,0" Click="BtnShuffle_Click">
                            <Path x:Name="IconShuffle" Data="M 10.59,9.17 L 5.41,4 L 4,5.41 L 9.17,10.58 L 10.59,9.17 Z M 14.5,4 L 16.29,5.71 L 4,18 L 5.41,19.41 L 17.7,7.12 L 19.41,8.83 L 19.41,4 L 14.5,4 Z M 14.5,14.83 L 13.08,16.25 L 16.29,19.46 L 17.7,18.05 L 14.5,14.83 Z" Fill="{StaticResource GrayBrush}" Stretch="Uniform" Width="20" Height="20"/>
                        </Button>
                        <Button Width="44" Height="44" Margin="0,0,25,0" Click="BtnPrev_Click">
                            <Path Data="M 12,0 L 0,10 L 12,20 Z M 0,0 L 2,0 L 2,20 L 0,20 Z" Fill="White" Stretch="Uniform" Width="16" Height="16"/>
                        </Button>
                        <Button x:Name="BtnPlayPause" Style="{StaticResource PlayerPlayButton}" Click="BtnPlayPause_Click" Margin="0,0,25,0">
                            <Path x:Name="BtnPlayPauseIcon" Data="M 0,0 L 16,10 L 0,20 Z" Fill="Black" Stretch="Uniform" Width="16" Height="16" Margin="3,0,0,0"/>
                        </Button>
                        <Button Width="44" Height="44" Margin="0,0,30,0" Click="BtnNext_Click">
                            <Path Data="M 0,0 L 12,10 L 0,20 Z M 10,0 L 12,0 L 12,20 L 10,20 Z" Fill="White" Stretch="Uniform" Width="16" Height="16"/>
                        </Button>
                        <Button x:Name="BtnRepeat" Width="40" Height="40" Background="Transparent" Click="BtnRepeat_Click">
                            <Grid>
                                <Path x:Name="IconRepeat" Data="M 7,7 H 17 V 10 L 21,6 L 17,2 V 5 H 5 V 11 H 7 V 7 Z M 17,17 H 7 V 14 L 3,18 L 7,22 V 19 H 19 V 13 H 17 V 17 Z" Fill="{StaticResource GrayBrush}" Stretch="Uniform" Width="20" Height="20"/>
                                <TextBlock x:Name="TxtRepeatState" Text="" FontSize="10" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,0"/>
                            </Grid>
                        </Button>
                    </StackPanel>
                    
                    <Grid MaxWidth="800" HorizontalAlignment="Stretch">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="50"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="TxtCurrentTime" Text="0:00" FontSize="11" Foreground="{StaticResource GrayBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Slider x:Name="PlaybackSlider" Grid.Column="1" Margin="20,0" Style="{StaticResource MinimalSlider}" 
                                Minimum="0" Maximum="100" Focusable="False" IsMoveToPointEnabled="True"
                                PreviewMouseDown="PlaybackSlider_MouseDown" PreviewMouseUp="PlaybackSlider_MouseUp"
                                ValueChanged="PlaybackSlider_ValueChanged"/>
                        <TextBlock x:Name="TxtTotalTime" Grid.Column="2" Text="0:00" FontSize="11" Foreground="{StaticResource GrayBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>

                <!-- Extras -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Width="40" Height="40" Background="Transparent" Margin="0,0,20,0" Click="BtnQueue_Click">
                        <Path Data="M 15,6 H 3 V 8 H 15 V 6 Z M 15,10 H 3 V 12 H 15 V 10 Z M 3,16 H 11 V 14 H 3 V 16 Z M 13,14 V 20 L 18,17 L 13,14 Z" Fill="{StaticResource GrayBrush}" Stretch="Uniform" Width="20" Height="20"/>
                    </Button>
                    <Canvas x:Name="WaveformCanvas" Width="120" Height="60" Margin="0,0,30,0"/>
                    <Path Data="M 3,9 V 15 H 7 L 12,20 V 4 L 7,9 H 3 Z M 16.5,12 C 16.5,10.23 15.48,8.71 14,7.97 V 16.02 C 15.48,15.29 16.5,13.77 16.5,12 Z M 14,3.23 V 5.29 C 16.89,6.15 19,8.83 19,12 C 19,15.17 16.89,17.85 14,18.71 V 20.77 C 18.01,19.86 21,16.28 21,12 C 21,7.72 18.01,4.14 14,3.23 Z" Fill="White" Stretch="Uniform" Width="18" Height="18" Margin="0,0,15,0"/>
                    <Slider x:Name="VolumeSlider" Width="100" Minimum="0" Maximum="100" Value="100" VerticalAlignment="Center" 
                            Style="{StaticResource MinimalSlider}" IsMoveToPointEnabled="True"
                            ValueChanged="VolumeSlider_ValueChanged"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Modals -->
        <Border x:Name="ModalOverlay" Grid.RowSpan="3" Grid.ColumnSpan="2" Background="#F2000000" Visibility="Collapsed">
            <Border Width="520" Background="{StaticResource SecondaryBrush}" Padding="50" VerticalAlignment="Center" CornerRadius="12">
                <StackPanel>
                    <TextBlock Text="Create New Playlist" FontSize="32" FontWeight="Bold" Margin="0,0,0,45"/>
                    <TextBox x:Name="TxtPlaylistName" Background="Transparent" Foreground="White" BorderBrush="{StaticResource GrayBrush}" 
                             BorderThickness="0,0,0,1" Padding="0,15" FontSize="22" Margin="0,0,0,50" 
                             local:PlaceholderBehavior.Placeholder="Give your playlist a name..."/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancel" Click="BtnCancelModal_Click" Margin="0,0,35,0" Foreground="{StaticResource GrayBrush}"/>
                        <Button Content="Create Playlist" Click="BtnConfirmCreatePlaylist_Click" FontWeight="Bold" FontSize="18"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- Info Popups (Features) -->
        <Border x:Name="FeaturePopup" Grid.RowSpan="3" Grid.ColumnSpan="2" Background="#B2000000" Visibility="Collapsed" MouseLeftButtonDown="PopupOverlay_MouseDown">
            <Border Width="400" Background="{StaticResource SecondaryBrush}" Padding="30" VerticalAlignment="Center" CornerRadius="12">
                <StackPanel>
                    <TextBlock x:Name="PopupTitle" Text="Feature" FontSize="24" FontWeight="Bold" Margin="0,0,0,15"/>
                    <TextBlock x:Name="PopupText" Text="Details coming soon." Foreground="{StaticResource GrayBrush}" TextWrapping="Wrap" FontSize="14"/>
                    <Button Content="Got it" Margin="0,25,0,0" HorizontalAlignment="Right" Click="BtnClosePopup_Click"/>
                </StackPanel>
            </Border>
        </Border>

    </Grid>
</Window>
